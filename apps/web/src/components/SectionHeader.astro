---
import Icon from './Icon.astro';
interface Props{number:string;label:string;title:string;emphasis?:string;link?:string;linkLabel?:string;description?:string;}
const {number,label,title,emphasis,link,linkLabel,description}=Astro.props;
---
<div class="section-heading"><div><p class="eyebrow">{number} <span>—</span> {label}</p><h2>{title} {emphasis&&<i>{emphasis}</i>}</h2>{description&&<p class="section-description">{description}</p>}</div>{link&&<a class="text-link" href={link}>{linkLabel||'Explore all'} <Icon name="right" size={17}/></a>}</div>
