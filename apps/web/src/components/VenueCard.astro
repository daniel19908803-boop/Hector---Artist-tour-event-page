---
import {imageAlt} from '../lib/image-alt';
import {venueEvents} from '../lib/data';
import type {Venue} from '../lib/types';
import Icon from './Icon.astro';
interface Props {venue:Venue;}
const {venue}=Astro.props;
---
<article class="venue-card"><a class="venue-image image-hover" href={`/venues/${venue.slug}`}><img src={venue.image} alt={imageAlt(venue.image)} width="720" height="480" loading="lazy"/>{venue.isNew&&<span class="genre-chip">Opening soon</span>}<span class="image-arrow"><Icon name="arrow"/></span></a><div class="venue-card-info"><div><h3><a href={`/venues/${venue.slug}`}>{venue.name}</a></h3><span class="mono">{venue.city}</span></div><footer><p>{venue.vibe}</p><a href={`/venues/${venue.slug}`}>{venueEvents(venue.id).length} upcoming <Icon name="right" size={14}/></a></footer></div></article>
