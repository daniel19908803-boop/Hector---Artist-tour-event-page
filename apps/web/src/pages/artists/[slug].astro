---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventRow from '../../components/EventRow.astro';
import Icon from '../../components/Icon.astro';
import {artists,artistEvents,events} from '../../lib/data';
export function getStaticPaths(){return artists.map(artist=>({params:{slug:artist.slug},props:{artist}}))}
const {artist}=Astro.props;
const upcoming=artistEvents(artist.id),past=events.filter(e=>e.artistId===artist.id&&new Date(e.endDateTime)<new Date());
---
<BaseLayout title={`${artist.name} — Tour dates & artist guide | LiveDiscover`} description={artist.bio} image={artist.image} schema={{'@context':'https://schema.org','@type':'MusicGroup',name:artist.name,description:artist.bio,genre:artist.genre,image:new URL(artist.image,Astro.site).href}}><div class="container page-section"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Discover</a><span>/</span><a href="/artists">Artists</a><span>/</span><span>{artist.name}</span></nav><section class="detail-hero"><img src={artist.image} alt={`Original stage-light artwork for ${artist.name}`} width="1440" height="650" fetchpriority="high"/><div><p class="eyebrow">{artist.genre} <span>·</span> {artist.hometown}</p><h1>{artist.name}</h1><p>{artist.tour} · {artist.dates} sample tour dates</p></div></section><div class="content-grid detail-content"><div class="detail-main"><p class="eyebrow">A little introduction</p><h2>Get to know <i>the sound.</i></h2><div class="prose"><p>{artist.bio}</p></div><div class="detail-actions"><button class="button button-ghost" data-follow={artist.id} aria-pressed="false"><Icon name="plus" size={17}/><span>Follow</span></button><a href={`/tours/${artist.tourSlug}`} class="button button-ghost">Explore the tour <Icon name="right" size={16}/></a><button class="button button-ghost" data-share>Share artist <Icon name="share" size={16}/></button></div><h2>Coming <i>your way.</i></h2>{upcoming.map(event=><EventRow event={event}/>)}{past.length>0&&<details class="archive"><summary>Past dates ({past.length})</summary>{past.map(event=><EventRow event={event}/>)}</details>}</div><aside class="detail-sidebar"><p class="eyebrow">On the road</p><h2 style="margin-top:15px">{artist.tour}</h2><p style="font-size:13px">{artist.dates} imagined dates. One reason to get out of the house.</p><div class="submit-explainer"><h3>Make room for discovery.</h3><p>Follow this artist to keep their upcoming Triangle shows in your Saved list.</p><button class="button button-primary" data-follow={artist.id} aria-pressed="false"><Icon name="plus" size={15}/><span>Follow</span></button></div><div class="info-banner">{artist.name} is an original fictional artist created for this demo.</div></aside></div></div></BaseLayout>
