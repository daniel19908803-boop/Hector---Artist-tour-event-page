---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtistCard from '../../components/ArtistCard.astro';
import {artists,genres} from '../../lib/data';
---
<BaseLayout title="Artists & tours coming to the Triangle | LiveDiscover"><section class="container page-section"><div class="page-intro"><p class="eyebrow">Find your next favorite</p><h1>Follow the<br/><i>feeling.</i></h1><p>The familiar names. The soon-to-be favorites.<br/>Meet the artists bringing their sound to the Triangle.</p></div><div class="grid-filter-bar"><label for="artist-genre">Your kind of music</label><select id="artist-genre" data-grid-filter="genre"><option value="">All genres</option>{genres.map(g=><option>{g}</option>)}</select><label class="sr-only" for="artist-sort">Sort artists</label><select id="artist-sort" data-artist-sort><option value="az">Name: A–Z</option><option value="za">Name: Z–A</option></select><span class="mono" data-grid-count>{artists.length} artists</span></div><div class="artist-grid" data-sort-grid>{[...artists].sort((a,b)=>a.name.localeCompare(b.name)).map(artist=><div data-grid-item data-name={artist.name} data-genre={artist.genre}><ArtistCard artist={artist}/></div>)}</div><div class="empty-state" data-grid-empty hidden><h2>A new sound is on its way.</h2><p>No sample artists in this genre yet. Try another filter.</p></div></section></BaseLayout>
