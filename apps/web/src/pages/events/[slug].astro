---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import EventRow from '../../components/EventRow.astro';
import RsvpForm from '../../islands/RsvpForm';
import {events,getArtist,getVenue,displayDate,upcomingEvents} from '../../lib/data';
export function getStaticPaths(){return events.map(event=>({params:{slug:event.slug},props:{event}}))}
const {event}=Astro.props;
const artist=getArtist(event.artistId),venue=getVenue(event.venueId);
const past=new Date(event.endDateTime)<new Date();
const unavailable=['cancelled','postponed','soldOut'].includes(event.status);
const status=event.status==='sellingFast'?'Selling fast':event.status==='fewLeft'?'Few left':event.status==='soldOut'?'Sold out':event.status==='cancelled'?'Cancelled':event.status==='postponed'?'Postponed':'Live in the Triangle';
const origin=Astro.site?.href.replace(/\/$/,'')||'https://livediscover.com';
const dateForGoogle=(date:string)=>date.replace(/[-:]/g,'').replace(/\.\d{3}Z/,'Z');
const googleCal='https://calendar.google.com/calendar/render?'+new URLSearchParams({action:'TEMPLATE',text:event.title,dates:`${dateForGoogle(event.startDateTime)}/${dateForGoogle(event.endDateTime)}`,details:event.description,location:`${venue.name}, ${venue.address}`,ctz:'America/New_York'});
const directions='https://www.google.com/maps/dir/?api=1&destination='+encodeURIComponent(venue.address);
const schema={'@context':'https://schema.org','@type':'MusicEvent',name:event.title+' (fictional demo event)',startDate:event.startDateTime,endDate:event.endDateTime,eventStatus:'https://schema.org/'+(event.status==='cancelled'?'EventCancelled':event.status==='postponed'?'EventPostponed':'EventScheduled'),eventAttendanceMode:'https://schema.org/OfflineEventAttendanceMode',location:{'@type':'MusicVenue',name:venue.name,address:{'@type':'PostalAddress',streetAddress:venue.address,addressLocality:venue.city,addressRegion:'NC',addressCountry:'US'},geo:{'@type':'GeoCoordinates',latitude:venue.lat,longitude:venue.lng}},image:[origin+artist.image],description:event.description,performer:{'@type':'MusicGroup',name:artist.name},organizer:{'@type':'Organization',name:'LiveDiscover demo',url:origin},offers:{'@type':'Offer',price:event.priceFrom,priceCurrency:'USD',availability:'https://schema.org/'+(event.status==='soldOut'?'SoldOut':'InStock'),url:`${origin}/events/${event.slug}`,validFrom:new Date().toISOString()}};
const related=upcomingEvents.filter(e=>e.id!==event.id&&(e.artistId===artist.id||e.venueId===venue.id)).slice(0,3);
---
<BaseLayout title={`${event.title} at ${venue.name}, ${venue.city} — ${displayDate(event.startDateTime,'MMM d, yyyy')} | LiveDiscover`} description={event.description} image={artist.image} schema={schema}>
<div class="container page-section"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Discover</a><span>/</span><a href="/events">Events</a><span>/</span><span>{event.title}</span></nav><section class="detail-hero"><img src={event.ticketing==='rsvp'?venue.image:artist.image} alt={`Original stage-light artwork for ${event.title}`} width="1440" height="650" fetchpriority="high"/><div><div class="detail-topline"><a href={`/genres/${event.genre.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/-$/,'')}`} class="eyebrow">{event.genre}</a><span class="status-pill">{status}</span></div><h1>{event.title}</h1><p>{event.eventType==='venueOpening'?'The Foundry Hall · Opening night':artist.tour}</p></div></section>
{past&&<div class="info-banner">This event has ended. The good news? There’s always another night. <a class="text-link" href="/events">Find an upcoming show →</a></div>}{event.status==='cancelled'&&<div class="info-banner">This sample event has been cancelled. No tickets are available.</div>}{event.status==='postponed'&&<div class="info-banner">This event has been postponed. A new date has not been announced.</div>}
<div class="content-grid detail-content"><div class="detail-main"><p class="eyebrow">Be in the room</p><h2>A night worth <i>going out for.</i></h2><div class="prose"><p>{event.description}</p><p>{artist.bio}</p></div><div class="detail-actions"><button class="button button-ghost" data-save={event.id} aria-pressed="false"><Icon name="heart" size={17}/>Save this show</button><button class="button button-ghost" data-share><Icon name="share" size={17}/>Share the night</button><a class="button button-ghost" href={`/events/${event.slug}.ics`} download><Icon name="calendar" size={17}/>Add to calendar</a><a class="button button-ghost" href={googleCal} target="_blank" rel="noopener noreferrer">Google Calendar <Icon name="arrow" size={16}/></a></div>
<h2>The <i>lineup.</i></h2><div class="prose"><p><a href={`/artists/${artist.slug}`}>{artist.name}</a> — {event.eventType==='venueOpening'?'opening-night headliner with special local guests':'headline set'}. Support and set times to be announced.</p></div><h2>Find your <i>way.</i></h2><p class="venue-address"><Icon name="pin" size={17}/><a href={`/venues/${venue.slug}`}>{venue.name}</a> — {venue.address}</p><div class="map-panel"><iframe title={`Map of ${venue.neighborhood}, ${venue.city}`} loading="lazy" src={`https://www.openstreetmap.org/export/embed.html?bbox=${venue.lng-.008},${venue.lat-.004},${venue.lng+.008},${venue.lat+.004}&layer=mapnik&marker=${venue.lat},${venue.lng}`} referrerpolicy="no-referrer"></iframe></div><a class="text-link" href={directions} target="_blank" rel="noopener noreferrer">Get directions <Icon name="arrow" size={16}/></a><div class="prose"><h3>Getting here</h3><p>{venue.parking}</p><h3>Accessibility</h3><p>{venue.accessibility}</p></div>{related.length>0&&<><h2>A little more <i>live music.</i></h2>{related.map(event=><EventRow event={event}/>)}</>}
</div><aside class="detail-sidebar" id="rsvp"><h2>{event.ticketing==='rsvp'?'You’re on the list.':'Make a night of it.'}</h2><dl class="info-list"><div><dt><Icon name="calendar" size={18}/><span>The date</span></dt><dd>{displayDate(event.startDateTime,'EEEE, MMMM d, yyyy')}</dd></div><div><dt><Icon name="clock" size={18}/><span>The time</span></dt><dd>Show {displayDate(event.startDateTime,'h:mm a')}<br/>Doors {displayDate(event.doorsTime,'h:mm a')} ET</dd></div><div><dt><Icon name="pin" size={18}/><span>The room</span></dt><dd><a href={`/venues/${venue.slug}`}>{venue.name}</a><br/>{venue.city}, NC</dd></div><div><dt><Icon name="ticket" size={18}/><span>The entry</span></dt><dd>{event.isFree?'Free with RSVP':`From $${event.priceFrom} + fees`}<br/>All ages · sample listing</dd></div></dl>
{!past&&!unavailable&&(event.ticketing==='rsvp'?<RsvpForm eventId={event.id} client:load/>:<><div class="info-banner">This is a fictional show created for the LiveDiscover demo. Live tickets are not available.</div><a class="button button-primary" href={`/artists/${artist.slug}`}>Explore the artist <Icon name="right" size={17}/></a></>)}{unavailable&&<div class="info-banner">{status}. Browse another night on the calendar.</div>}<p class="mono">Original sample content · Demo experience</p></aside></div></div>
</BaseLayout>
