---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ArtistCard from '../components/ArtistCard.astro';
import VenueCard from '../components/VenueCard.astro';
import SubmitBand from '../components/SubmitBand.astro';
import EventList from '../islands/EventList';
import OpeningCountdown from '../components/OpeningCountdown.astro';
import {artists,venues,eventIndex,upcomingEvents,getArtist,getVenue,genres,displayDate,openingDate} from '../lib/data';
const featured=upcomingEvents.find(e=>e.featured)||upcomingEvents[0];
const artist=getArtist(featured.artistId),venue=getVenue(featured.venueId);
const foundry=venues.find(v=>v.id==='foundry')!;
---
<BaseLayout schema={{'@context':'https://schema.org','@type':'WebSite',name:'LiveDiscover',url:Astro.site?.href,description:'A demo live music discovery experience for the Triangle.'}}>
 <link slot="head" rel="preload" as="image" href="/images/hero-stage.webp" imagesrcset="/images/hero-stage-small.webp 960w, /images/hero-stage.webp 1920w" imagesizes="100vw"/>
 <section class="hero">
  <img class="hero-image" src="/images/hero-stage.webp" srcset="/images/hero-stage-small.webp 960w, /images/hero-stage.webp 1920w" sizes="100vw" width="1920" height="1120" alt="" fetchpriority="high"/>
  <div class="hero-scrim"></div>
  <div class="container hero-inner"><div class="hero-top"><div class="hero-copy"><p class="eyebrow hero-eyebrow"><span class="tiny-dot"></span> Raleigh <span>·</span> Durham <span>·</span> Chapel Hill</p><h1>Where the<br/>night <i>begins.</i></h1><p class="hero-description">The next great show. The room you haven’t found yet.<br class="desktop-break"/> Your guide to live music in the Triangle.</p><a href="#upcoming" class="hero-browse">Find your next night out <Icon name="right" size={19}/></a></div>
  <article class="featured-event"><div class="featured-top"><span class="mono">In the spotlight</span><span class="status-pill"><span class="tiny-dot"/>Selling fast</span></div><div class="featured-artist"><p class="featured-kicker">Featured tour</p><h2><a href={`/events/${featured.slug}`}>{artist.name}</a></h2><p>{artist.tour}</p></div><div class="featured-info"><p><Icon name="calendar" size={16}/>{displayDate(featured.startDateTime,'EEE, MMM d')}<span>·</span>{displayDate(featured.startDateTime,'h:mm a')}</p><p><Icon name="pin" size={16}/>{venue.name}, {venue.city}</p></div><a href={`/events/${featured.slug}`} class="button button-light">Get tickets <Icon name="right" size={17}/></a><span class="featured-pagination"><b></b><span>Curated for the Triangle</span></span></article></div>
  <form class="hero-search" action="/events" method="get"><div class="search-field search-text"><Icon name="search" size={21}/><div><label for="hero-query">Search</label><input id="hero-query" type="search" name="q" placeholder="Artist, venue or city"/></div></div><div class="search-field"><Icon name="calendar" size={20}/><div><label for="hero-when">When</label><select id="hero-when" name="when"><option value="all">Any time</option><option value="tonight">Tonight</option><option value="week">This week</option><option value="weekend">This weekend</option><option value="month">This month</option></select></div></div><div class="search-field"><Icon name="music" size={20}/><div><label for="hero-genre">Genre</label><select id="hero-genre" name="genre"><option value="">All genres</option>{genres.map(genre=><option>{genre}</option>)}</select></div></div><button class="button button-primary" type="submit">Find shows <Icon name="right" size={18}/></button></form>
  <div class="hero-caption"><span>Good music. Close to home.</span><span class="mono"><span class="tiny-dot"></span> Independently curated. Locally loved.</span></div></div>
 </section>
 <div class="scene-strip"><div class="container"><p><span class="tiny-dot"></span> A whole scene. One place.</p><span>Big nights. Small rooms. And everything in between.</span><a href="/about">Meet LiveDiscover <Icon name="arrow" size={14}/></a></div></div>
 <section id="upcoming" class="section container upcoming-section"><SectionHeader number="01" label="Upcoming near you" title="On stage in the" emphasis="Triangle." link="/events" linkLabel="All upcoming events"/><EventList client:load events={eventIndex} mode="home"/></section>
 <section class="section artists-section"><div class="container"><SectionHeader number="02" label="On the road" title="Artists coming" emphasis="your way." link="/artists" linkLabel="Explore artists & tours"/><div class="artist-grid">{artists.slice(0,4).map(artist=><ArtistCard artist={artist}/>)}</div></div></section>
 <section class="section container opening-section"><SectionHeader number="03" label="Opening soon" title="The next great room." emphasis="Be there first." link="/openings" linkLabel="All new openings"/><div class="opening-panel"><div class="opening-image"><img src={foundry.image} alt="Warm amber lights illuminating an industrial-style stage" width="1000" height="900" loading="lazy"/><div class="opening-image-overlay"></div><OpeningCountdown openingDate={foundry.opening!.openingDate} timezone={foundry.timezone}/><div class="opening-image-wordmark" aria-hidden="true"><span>The </span>Foundry<small> Hall / Raleigh, NC</small></div></div><div class="opening-copy"><p class="eyebrow"><span class="tiny-dot"></span> New venue <span>·</span> Warehouse District, Raleigh</p><h3>A little history.<br/><i>A whole new sound.</i></h3><p class="opening-name">Meet The Foundry Hall.</p><p>Old brick. New noise. A former industrial space, reimagined for the nights that turn into stories. Get a first look at Raleigh’s next gathering place.</p><dl class="opening-details"><div><dt>Opening night</dt><dd>{displayDate(openingDate,'MMM d, yyyy')}</dd></div><div><dt>Doors</dt><dd>7:00 PM</dd></div><div><dt>Entry</dt><dd>Free with RSVP</dd></div></dl><div class="opening-actions"><a href="/events/the-foundry-hall-opening-night#rsvp" class="button button-primary">RSVP for opening night <Icon name="right" size={16}/></a><a href="/events/the-foundry-hall-opening-night.ics" class="calendar-button" aria-label="Add Foundry Hall opening to calendar"><Icon name="calendar" size={21}/></a></div><p class="opening-note">A fictional venue. A very real love of live music.</p></div></div></section>
 <section class="section venue-section"><div class="container"><SectionHeader number="04" label="Find your room" title="Rooms worth" emphasis="knowing." link="/venues" linkLabel="Explore all venues"/><div class="venue-grid">{venues.slice(0,3).map(venue=><VenueCard venue={venue}/>)}</div><p class="venues-footnote"><Icon name="pin" size={15}/> From downtown Raleigh to the heart of Carrboro. There’s a room for you.</p></div></section>
 <SubmitBand/>
</BaseLayout>
