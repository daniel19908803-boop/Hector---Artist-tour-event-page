---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventRow from '../components/EventRow.astro';
import Icon from '../components/Icon.astro';
import OpeningCountdown from '../components/OpeningCountdown.astro';
import {venues,events,displayDate,openingDate} from '../lib/data';
const foundry=venues.find(v=>v.id==='foundry')!;
const opening=events.find(e=>e.eventType==='venueOpening')!;
---
<BaseLayout title="New music venues & opening nights in the Triangle | LiveDiscover"><section class="container page-section"><div class="page-intro"><p class="eyebrow">A new place to make memories</p><h1>Opening <i>soon</i></h1><p>Be part of the beginning. Discover new stages and the opening nights<br/>that will become “I was there” stories.</p></div><div class="content-grid"><div><div class="opening-image" style="border-radius:15px;min-height:440px"><img src={foundry.image} alt="Amber stage lights inside an industrial music hall" width="1000" height="700"/><OpeningCountdown openingDate={foundry.opening!.openingDate} timezone={foundry.timezone}/><div class="opening-image-wordmark"><span>The </span>Foundry<small> Hall / Raleigh, NC</small></div></div><div class="prose"><h2>A little history.<br/><i>A whole new sound.</i></h2><p>{foundry.description}</p></div><EventRow event={opening}/></div><aside class="detail-sidebar"><p class="eyebrow">The first night</p><h2 style="margin-top:15px">The Foundry Hall</h2><p style="font-size:13px">Warehouse District, Raleigh</p><dl class="opening-details" style="grid-template-columns:1fr 1fr"><div><dt>Opening night</dt><dd>{displayDate(openingDate,'MMM d, yyyy')}</dd></div><div><dt>Doors</dt><dd>7:00 PM ET</dd></div><div><dt>Entry</dt><dd>Free with RSVP</dd></div><div><dt>The room</dt><dd>400 capacity</dd></div></dl><a class="button button-primary" href="/events/the-foundry-hall-opening-night#rsvp">Explore opening night <Icon name="right" size={16}/></a><a class="button button-ghost" href="/venues/the-foundry-hall">Meet the venue <Icon name="arrow" size={16}/></a><div class="info-banner">The Foundry Hall and its opening night are fictional demo content.</div></aside></div></section></BaseLayout>
