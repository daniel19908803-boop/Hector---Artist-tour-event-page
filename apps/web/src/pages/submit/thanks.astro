---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
---
<BaseLayout title="Your event draft is saved | LiveDiscover"><section class="container page-section simple-page"><div class="page-intro"><p class="eyebrow">One step closer to a great night</p><h1>The first draft<br/><i>is yours.</i></h1><p>Your event draft is saved on this browser. Nothing has been published or sent to an editor. You can go back to refine it or download a copy for later.</p></div><div class="detail-actions"><button id="download-draft" class="button button-primary">Download your draft <Icon name="right" size={17}/></button><a href="/submit" class="button button-ghost">Back to my draft <Icon name="right" size={17}/></a><a href="/events" class="button button-ghost">Explore the scene <Icon name="arrow" size={17}/></a></div><p id="draft-feedback" class="form-feedback" role="status"></p></section></BaseLayout>
<script>document.querySelector('#download-draft')?.addEventListener('click',()=>{const feedback=document.querySelector('#draft-feedback');try{const draft=localStorage.getItem('ld:submission-draft');if(!draft){if(feedback)feedback.textContent='No draft found in this browser. Create one on the submission page.';return}const blob=new Blob([JSON.stringify(JSON.parse(draft),null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download='livediscover-event-draft.json';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}catch{if(feedback)feedback.textContent='The draft could not be downloaded from this browser.';}});</script>
