---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventRow from '../../components/EventRow.astro';
import Icon from '../../components/Icon.astro';
import {artists,artistEvents} from '../../lib/data';
export function getStaticPaths(){return artists.map(artist=>({params:{slug:artist.tourSlug},props:{artist}}))}
const {artist}=Astro.props;
---
<BaseLayout title={`${artist.tour} — ${artist.name} | LiveDiscover`} description={artist.bio} image={artist.image}><section class="container page-section"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/artists">Artists</a><span>/</span><a href={`/artists/${artist.slug}`}>{artist.name}</a><span>/</span><span>The tour</span></nav><div class="page-intro"><p class="eyebrow">On the road with {artist.name}</p><h1>{artist.tour.split(' ').slice(0,-1).join(' ')}<br/><i>{artist.tour.split(' ').slice(-1)}</i></h1><p>{artist.bio}</p></div><p class="eyebrow" style="margin-bottom:25px"><Icon name="pin" size={15}/> Your Triangle dates</p>{artistEvents(artist.id).map(event=><EventRow event={event}/>)}<div class="info-banner">This is a fictional tour. The demo includes its Triangle dates; additional tour dates are illustrative.</div><a class="text-link" href={`/artists/${artist.slug}`}>More about {artist.name} <Icon name="right" size={16}/></a></section></BaseLayout>
