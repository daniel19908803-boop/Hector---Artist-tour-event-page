---
import {imageAlt} from '../../lib/image-alt';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventRow from '../../components/EventRow.astro';
import Icon from '../../components/Icon.astro';
import OpeningCountdown from '../../components/OpeningCountdown.astro';
import {venues,venueEvents,events,displayDate} from '../../lib/data';
export function getStaticPaths(){return venues.map(venue=>({params:{slug:venue.slug},props:{venue}}))}
const {venue}=Astro.props;
const upcoming=venueEvents(venue.id),past=events.filter(e=>e.venueId===venue.id&&new Date(e.endDateTime)<new Date());
const directions='https://www.google.com/maps/dir/?api=1&destination='+encodeURIComponent(venue.address);
---
<BaseLayout title={`${venue.name} — Live music in ${venue.city} | LiveDiscover`} description={venue.description} image={venue.image} schema={{'@context':'https://schema.org','@type':'MusicVenue',name:venue.name,description:venue.description,image:new URL(venue.image,Astro.site).href,address:{'@type':'PostalAddress',streetAddress:venue.address,addressLocality:venue.city,addressRegion:'NC',addressCountry:'US'},geo:{'@type':'GeoCoordinates',latitude:venue.lat,longitude:venue.lng}}}><div class="container page-section"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Discover</a><span>/</span><a href="/venues">Venues</a><span>/</span><span>{venue.name}</span></nav><section class="detail-hero"><img src={venue.image} alt={imageAlt(venue.image)} width="1440" height="650" fetchpriority="high"/><div><p class="eyebrow">{venue.city} <span>·</span> {venue.neighborhood}</p><h1>{venue.name}</h1><p>{venue.vibe}</p></div></section>{venue.isNew&&<div class="info-banner">A new room. A new beginning. <OpeningCountdown openingDate={venue.opening!.openingDate} timezone={venue.timezone} inline/> · {displayDate(venue.opening!.openingDate,'MMMM d, yyyy')}. <a href="/events/the-foundry-hall-opening-night#rsvp" class="text-link">Explore opening night →</a></div>}<div class="content-grid detail-content"><div class="detail-main"><p class="eyebrow">The room, the feeling</p><h2>A place to <i>be there.</i></h2><div class="prose"><p>{venue.description}</p></div><h2>Coming <i>to the stage.</i></h2>{upcoming.length?upcoming.map(event=><EventRow event={event}/>):<div class="empty-state"><h2>A little pause between sets.</h2><p>New sample dates are on the way.</p><a href="/events" class="button button-ghost">Browse all shows →</a></div>}{past.length>0&&<details class="archive"><summary>Past shows ({past.length})</summary>{past.map(event=><EventRow event={event}/>)}</details>}<div class="prose"><h2>Good to know.</h2><h3>Parking & getting here</h3><p>{venue.parking}</p><h3>Accessibility</h3><p>{venue.accessibility}</p></div></div><aside class="detail-sidebar"><h2>Find the room.</h2><p class="venue-address"><Icon name="pin" size={17}/>{venue.address}</p><div class="map-panel"><iframe title={`Map of ${venue.name}`} loading="lazy" src={`https://www.openstreetmap.org/export/embed.html?bbox=${venue.lng-.008},${venue.lat-.004},${venue.lng+.008},${venue.lat+.004}&layer=mapnik&marker=${venue.lat},${venue.lng}`} referrerpolicy="no-referrer"></iframe></div><a class="button button-primary" href={directions} target="_blank" rel="noopener noreferrer">Get directions <Icon name="arrow" size={16}/></a><div class="submit-explainer"><p><strong>Neighborhood</strong><br/>{venue.neighborhood}</p><p><strong>Sample capacity</strong><br/>{venue.capacity.toLocaleString()} people</p><p><strong>Local time</strong><br/>America/New_York</p></div><p class="mono">Illustrative listing · Confirm details with the venue</p></aside></div></div></BaseLayout>
